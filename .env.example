# Copy to `.env` (gitignored) to cut a release with `bun run release`.
# These are needed ONLY to publish — running/building the app does not
# require any of them. NEVER commit real values.

# Tauri updater signing key. Either the path to the minisign private key
# file, or its full inline content. This signs the .sig files the updater
# verifies before installing — losing or leaking it breaks/compromises
# auto-update for every user. Keep it offline; do not commit it.
TAURI_SIGNING_PRIVATE_KEY=

# Password for the signing key, if one was set at keygen time. Leave empty
# if the key has no password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# GitHub repo that releases + the auto-update manifest are published to.
# Defaults to ThizeTools/GitBee (the public project repo) when unset.
RELEASE_REPO=ThizeTools/GitBee
