# Releases are built and signed in CI (.github/workflows/release.yml), so no
# local .env is needed to publish. See docs/specs/release-and-updates.md.
#
# Only for a manual local build that must produce signed updater artifacts:
# the minisign private key (path or full content) and its password, if any.
# NEVER commit real values.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
